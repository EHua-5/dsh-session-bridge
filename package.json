{
  "name": "@local/dsh-session-bridge",
  "version": "0.5.1",
  "description": "DSH session bridge: local HTTP inbox, cross-session model switching with target consent, and image/video/audio generation tools.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/inbox.test.js && node test/model.test.js"
  },
  "exports": {
    ".": "./model.js",
    "./inbox": "./inbox.js",
    "./model": "./model.js",
    "./shared": "./shared.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./media": "./media.js"
  },
  "files": [
    "inbox.js",
    "model.js",
    "shared.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "bridge",
    "inbox",
    "model"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
